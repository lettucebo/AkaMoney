    },
    {
      "feature": "依到期時間與封存旗標推導狀態",
      "class": "B",
      "note": "前端以 expires_at 與 is_active 推導作用中／已過期／已封存"
    },
    {
      "feature": "全域搜尋與跨頁點擊數排序",
      "class": "C",
      "note": "示範對 large250 全資料集搜尋／排序後再分頁；正式環境需列表 API 新增 q 與 sort 參數，現況僅支援 page／limit"
    },
    {
      "feature": "來源（referrer）分佈",
      "class": "C",
      "note": "現有 AnalyticsResponse 僅提供 recent_clicks[].referer，需後端新增聚合欄位才能正式上線"
