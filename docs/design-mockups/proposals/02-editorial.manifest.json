  "capabilities": [
    {
      "feature": "每日點擊趨勢折線圖",
      "class": "A",
      "note": "取自 AnalyticsResponse.clicks_by_date / dailySeries"
    },
    {
      "feature": "國家分佈圖",
      "class": "A",
      "note": "取自 clicks_by_country / countryDistribution"
    },
    {
      "feature": "裝置分佈圖",
      "class": "A",
      "note": "取自 clicks_by_device / deviceDistribution"
    },
    {
      "feature": "瀏覽器分佈圖",
      "class": "A",
      "note": "取自 clicks_by_browser / browserDistribution"
    },
    {
      "feature": "總覽 KPI 與 Top Links 榜單",
      "class": "A",
      "note": "取自 OverallStatsResponse.top_links 等欄位"
    },
    {
      "feature": "依到期時間與封存旗標推導狀態",
      "class": "B",
      "note": "前端以 expires_at 與 is_active 推導作用中／已過期／已封存，純前端計算"
    },
    {
      "feature": "短代碼／標題關鍵字高亮",
      "class": "B",
      "note": "搜尋命中時以前端字串處理標記片段，不需後端變更"
    },
    {
      "feature": "全域跨頁搜尋與排序",
      "class": "C",
      "note": "示範對 large250 全資料集搜尋／排序後再分頁；正式環境需列表 API 新增 q 與 sort 參數，現況僅支援 page／limit"
    },
    {
      "feature": "來源（referrer）分佈敘事",
      "class": "C",
      "note": "AnalyticsResponse 無聚合欄位，需後端就 recent_clicks[].referer 聚合"
    }
  ]
}
