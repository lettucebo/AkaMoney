{
  "id": "03-swiss",
  "title": "瑞士國際主義網格控制台",
  "provider": "Anthropic",
  "model": "claude-opus-5",
  "direction": "Swiss 國際主義排版",
  "stack": "手寫 CSS",
  "dna": {
    "navigation": "top-bar",
    "linkRepresentation": "compact-rows",
    "createFlow": "inline-quick-create",
    "analyticsModel": "comparative",
    "mobileStrategy": "horizontal-scroll-table",
    "workMode": "edit"
  },
  "tokens": {
    "colors": {
