  "capabilities": [
    {
      "feature": "點擊趨勢（按日期）",
      "class": "A",
      "note": "使用 AnalyticsResponse 與 OverallStatsResponse 的日期趨勢資料"
    },
    {
      "feature": "國家分佈",
      "class": "A",
      "note": "使用 country_distribution"
    },
    {
      "feature": "裝置分佈",
      "class": "A",
      "note": "使用 device_distribution"
    },
    {
      "feature": "瀏覽器分佈",
      "class": "A",
      "note": "使用 clicks_by_browser"
    },
    {
      "feature": "總覽 KPI 與 Top Links",
      "class": "A",
      "note": "使用 OverallStatsResponse"
    },
    {
      "feature": "依到期時間標示連結狀態",
      "class": "B",
      "note": "前端以 expires_at 與 is_active 推導作用中／已過期／已封存"
    },
    {
      "feature": "短代碼／標題關鍵字高亮",
      "class": "B",
      "note": "搜尋命中時以前端字串處理標記片段"
    },
    {
      "feature": "全域搜尋與跨頁點擊數排序",
      "class": "C",
      "note": "示範對 large250 全資料集搜尋／排序後再分頁；正式環境需列表 API 新增 q 與 sort 參數，現況僅支援 page／limit"
    }
  ]
