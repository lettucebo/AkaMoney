  "capabilities": [
    {
      "feature": "點擊趨勢（按日期）",
      "class": "A",
      "note": "使用 AnalyticsResponse.clicks_by_date 與 OverallStatsResponse.click_trend，以 Chart.js 真實資料繪製。"
    },
    {
      "feature": "國家分佈",
      "class": "A",
      "note": "使用 clicks_by_country 與 country_distribution 呈現分析與總覽分佈圖。"
    },
    {
      "feature": "裝置分佈",
      "class": "A",
      "note": "使用 clicks_by_device 與 device_distribution 呈現裝置比較。"
    },
    {
      "feature": "瀏覽器分佈",
      "class": "A",
      "note": "使用 clicks_by_browser 於單一短網址成效分析中呈現。"
    },
    {
      "feature": "總覽 KPI 與 Top Links",
      "class": "A",
      "note": "使用 OverallStatsResponse 的總點擊、作用中、全部連結與 top_links。"
    },
    {
      "feature": "依到期時間標示連結狀態",
      "class": "B",
      "note": "前端以 expires_at 與 is_active 推導作用中／已封存／已過期。"
    },
    {
      "feature": "短代碼／原始網址／標題關鍵字高亮",
      "class": "B",
      "note": "搜尋命中時以前端字串處理標記片段，純前端計算。"
    },
    {
      "feature": "全域搜尋與跨頁點擊數排序",
      "class": "C",
      "note": "示範對 large250 全資料集搜尋／排序後再分頁；正式環境需列表 API 新增 q 與 sort 參數，現況僅支援 page／limit"
    }
  ]
