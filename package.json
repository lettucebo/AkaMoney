{
  "name": "akamoney",
  "version": "1.5.0",
  "description": "URL Shortening Service with Vue 3 and Cloudflare Workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "src/frontend",
    "src/backend",
    "src/redirect"
  ],
  "scripts": {
    "dev": "npm run dev:frontend & npm run dev:backend",
    "dev:frontend": "npm run dev -w akamoney-frontend",
    "dev:backend": "npm run dev -w akamoney-backend",
    "dev:redirect": "npm run dev -w akamoney-redirect",
    "build": "npm run build:frontend && npm run build:backend && npm run build:redirect",
    "build:frontend": "npm run build -w akamoney-frontend",
    "build:backend": "npm run build -w akamoney-backend",
    "build:redirect": "npm run build -w akamoney-redirect",
    "test": "npm run test:frontend && npm run test:backend && npm run test:redirect",
    "test:frontend": "npm run test -w akamoney-frontend",
    "test:backend": "npm run test -w akamoney-backend",
    "test:redirect": "npm run test -w akamoney-redirect",
    "test:coverage": "npm run test:coverage:frontend && npm run test:coverage:backend && npm run test:coverage:redirect",
    "test:coverage:frontend": "npm run test:coverage -w akamoney-frontend",
    "test:coverage:backend": "npm run test:coverage -w akamoney-backend",
    "test:coverage:redirect": "npm run test:coverage -w akamoney-redirect",
    "deploy": "npm run deploy:frontend && npm run deploy:backend && npm run deploy:redirect",
    "deploy:frontend": "npm run deploy -w akamoney-frontend",
    "deploy:backend": "npm run deploy -w akamoney-backend",
    "deploy:redirect": "npm run deploy -w akamoney-redirect",
    "setup": "npm install"
  },
  "keywords": [
    "url-shortener",
    "vue3",
    "cloudflare-workers",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
