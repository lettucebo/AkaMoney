# Local development configuration for redirect service
# Copy this file to wrangler.local.toml and fill in your database_id
# Run with: wrangler dev --config wrangler.local.toml --port 8788
# (Use port 8788 to avoid conflicts with the Admin API running on default port 8787)

name = "akamoney-redirect"
main = "src/index.ts"
compatibility_date = "2024-12-17"
compatibility_flags = ["nodejs_compat"]

# Workers configuration
workers_dev = true
upload_source_maps = true

[version_metadata]
binding = "CF_VERSION_METADATA"

[observability]
enabled = true
head_sampling_rate = 1

# D1 Database binding
[[d1_databases]]
binding = "DB"
database_name = "akamoney-clicks"
database_id = "YOUR_DATABASE_ID_HERE"

# Environment variables
[vars]
ENVIRONMENT = "development"
# Public Sentry DSN placeholder. This is not a secret; use wrangler.local.toml for a local test DSN.
# Do not put Sentry auth tokens in Wrangler config; store tokens only in CI/secrets.
SENTRY_DSN = ""
