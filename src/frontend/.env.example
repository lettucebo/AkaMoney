# API Configuration
VITE_API_URL=http://localhost:8787

# Entra ID Configuration
VITE_ENTRA_ID_CLIENT_ID=your_client_id
VITE_ENTRA_ID_TENANT_ID=your_tenant_id
VITE_ENTRA_ID_REDIRECT_URI=http://localhost:5173

# Application Configuration
VITE_APP_NAME=AkaMoney
VITE_SHORT_DOMAIN=http://localhost:8788

# Sentry Monitoring Configuration
# Leave DSN empty for local no-op behavior. Do not commit real DSN values.
VITE_SENTRY_DSN=
# Environment label reported to Sentry (for example: development, staging, production)
VITE_SENTRY_ENVIRONMENT=development
# Error-only Replay is enabled unless this is set to 'false'. Normal sessions remain sampled at 0%.
VITE_SENTRY_REPLAY_ENABLED=false

# Development Mode: Skip authentication (set to 'true' to enable)
# Only works in development mode (NODE_ENV=development)
# Useful for automated testing, screenshots, and UI demos
# VITE_SKIP_AUTH=true
